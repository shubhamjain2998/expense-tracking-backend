# Development dependencies — only installed by contributors and CI.
# Compile to a fully-pinned, hash-locked requirements-dev.txt with:
#     pip-compile --generate-hashes requirements-dev.in -o requirements-dev.txt
#
# `pip-sync requirements-dev.txt` will then install everything from both
# the prod and dev lockfiles (since this file references requirements.txt).

# Pull in the locked production deps too, so a dev environment is a superset.
-r requirements.txt

# Lockfile tooling
pip-tools>=7.5

# Formatter + linter (mirror the .pre-commit-config.yaml versions)
black==25.11.0
flake8==7.3.0

# Test framework + coverage
pytest>=8
pytest-cov>=5
# Required by fastapi.testclient → starlette.testclient. Not pinned by
# fastapi itself, so a clean Linux install would miss it without an
# explicit dependency here.
httpx>=0.28

# Pre-commit harness
pre-commit>=4
# pre-commit pulls in virtualenv. virtualenv 21.x bumped its filelock floor
# to >=3.24.2 on Py3.10+; that constraint isn't visible when pip-compile
# runs on Py3.9, so the lockfile ends up inconsistent across platforms.
# Cap virtualenv at the 20.x line, whose filelock requirement (>=3.4.1) is
# permissive enough to resolve identically on both Pythons.
virtualenv<21

# Security scanners — used in CI and (bandit) in pre-commit
bandit[toml]>=1.7
pip-audit>=2.7
