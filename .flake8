[flake8]
max-line-length = 88
# Compatible with black:
#   E203  whitespace before ':' (black breaks slices differently)
#   W503  line break before binary operator (PEP 8 now prefers line break BEFORE)
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    alembic/versions,
    build,
    dist
