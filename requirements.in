# Production dependencies — direct (top-level) imports only.
# Compile to a fully-pinned, hash-locked requirements.txt with:
#     pip-compile --generate-hashes requirements.in -o requirements.txt
# Render's build command runs `pip install -r requirements.txt`, so the
# compiled file is what is shipped.

# Web framework + ASGI server
fastapi==0.115.6
